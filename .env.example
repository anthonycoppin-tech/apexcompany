# ─────────────────────────────────────────────────────────────
# Copier en .env.local (apps/web) et .env (apps/bot).
# Ne jamais committer les valeurs réelles.
# ─────────────────────────────────────────────────────────────

# Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne la RLS. Serveur uniquement, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=

# Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Whop ────────────────────────────────────────────────────────
# Le prestataire de paiement depuis le 23 septembre 2026. Les trois sont
# nécessaires : sans l'une, aucun paiement ne s'ouvre ou aucun encaissement
# n'est reçu — et un encaissement non reçu est un client qui a payé sans accès.
#
# WHOP_API_KEY       — Dashboard > Developer. Serveur uniquement, jamais NEXT_PUBLIC_.
# WHOP_ACCOUNT_ID    — Dashboard > Settings, de la forme `biz_…`.
# WHOP_WEBHOOK_SECRET— Dashboard > Developer > Webhooks, de la forme `ws_…`.
#                      À recopier telle quelle : le préfixe fait partie de la clé.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=

# Cal.com ─────────────────────────────────────────────────────
# Une seule page de réservation, celle de Franck : il prend tous les audits.
NEXT_PUBLIC_CAL_LIEN=
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
# Le formateur affecté par défaut à un audit réservé par quelqu'un qui n'a pas
# de fiche prospect. En pratique, l'identifiant du compte de Franck.
AUDIT_CONSEILLER_USER_ID=

# Discord ─────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Ces deux-là ne sont lues QUE par supabase/config.toml, donc par une instance
# Supabase locale. Contre le projet hébergé, l'identifiant et le secret de
# l'application Discord se saisissent dans le tableau de bord Supabase
# (Authentication → Providers → Discord), pas ici.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Le rôle attribué à la liaison du compte, avant tout achat. Les rôles de
# produit, eux, vivent dans formations.discord_role_id, un par formation.
DISCORD_ROLE_INVITE_ID=
# L'invitation au serveur n'est plus une variable : elle est fournie depuis le
# 23 septembre 2026 et vit dans `apps/web/src/lib/reseaux.ts`, avec les trois
# comptes publics. Si elle change, c'est là — et nulle part ailleurs.

# Hébergeur vidéo (replays) — à trancher : Cloudflare Stream ou Bunny
# cf. docs/06-PERIMETRE.md
VIDEO_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

# Emails ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="ApexCompany <no-reply@example.com>"
# Signature du webhook Resend (api/resend), qui rapporte livraisons, rebonds et
# plaintes. Donnée par Resend à la création du webhook, sous la forme whsec_...
# Sans elle, le registre s'arrête à « envoyé » : on ne sait jamais si un email
# est arrivé chez son destinataire, et un rebond reste invisible.
RESEND_WEBHOOK_SECRET=

# Tâches planifiées ───────────────────────────────────────────
# Secret attendu en en-tête Authorization par api/cron/revocation.
CRON_SECRET=

# Copier en .env, à côté de ce fichier (apps/bot/.env — pas la racine du monorepo).

NEXT_PUBLIC_SUPABASE_URL=
# Contourne la RLS. Le worker n'a pas de session utilisateur : c'est pour ça
# qu'il en a besoin, pas une exception à la règle.
SUPABASE_SERVICE_ROLE_KEY=

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Le rôle attribué à la liaison du compte, avant tout achat. Le worker ne s'en
# sert pas — c'est le site qui l'empile dans la file. Elle est répétée ici pour
# que `npm run discord:check` puisse vérifier qu'elle existe sur le serveur et
# qu'elle est bien sous le rôle du bot dans la hiérarchie.
DISCORD_ROLE_INVITE_ID=

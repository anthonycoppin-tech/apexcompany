{
  "name": "apex-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme ApexCompany — CRM, paiements, sessions live et replays",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@apex/web",
    "dev:bot": "npm run dev --workspace=@apex/bot",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "db:test": "supabase test db",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,json,md,css}\"",
    "db:check": "node scripts/verifier-schema.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "prettier": "^3.4.2",
    "supabase": "^2.2.1",
    "typescript": "^5.7.3"
  }
}
